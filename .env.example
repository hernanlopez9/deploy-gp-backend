```env
# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================

# Puerto en el que se ejecutará la API.
PORT=3000

# Nombre o dirección del servidor donde se ejecuta la aplicación.
SERVER=localhost

# Host utilizado por el servidor para aceptar conexiones.
HOST=localhost

# Entorno de ejecución de la aplicación.
# Valores habituales: development | production | test
NODE_ENV=development


# ============================================================
# BASE DE DATOS — SQL SERVER / PRISMA
# ============================================================

# Cadena de conexión utilizada por Prisma para conectarse
# a la base de datos AdventureWorks2022 en SQL Server.
#
# Formato:
# sqlserver://HOST:PUERTO;database=BASE_DE_DATOS;user=USUARIO;password=CONTRASEÑA;trustServerCertificate=true
#
# IMPORTANTE:
# Reemplazar YOUR_DATABASE_PASSWORD por la contraseña
# configurada para el usuario de SQL Server.
DATABASE_URL="sqlserver://localhost:1433;database=AdventureWorks2022;user=sa;password=YOUR_DATABASE_PASSWORD;trustServerCertificate=true"


# ============================================================
# SEGURIDAD DE LA API
# ============================================================

# Clave utilizada para autenticar/proteger determinadas
# solicitudes de la API.
API_KEY=YOUR_API_KEY


# ============================================================
# CORS
# ============================================================

# Origen(es) desde los cuales el frontend puede realizar
# solicitudes HTTP hacia la API.
CORS_ORIGIN=http://localhost:5173


# ============================================================
# URL DE LA APLICACIÓN
# ============================================================

# URL principal utilizada por la aplicación.
URL=http://localhost:5173


# ============================================================
# AUTENTICACIÓN — JWT
# ============================================================

# Clave secreta utilizada para firmar y verificar
# los tokens JWT.
#
# En producción debe utilizarse una clave larga,
# aleatoria y privada.
JWT_SECRET=YOUR_JWT_SECRET

# Tiempo de expiración del token JWT.
# Ejemplo: 7d = 7 días.
JWT_EXPIRES_IN=7d


# ============================================================
# REFRESH TOKEN
# ============================================================

# Clave secreta utilizada para firmar/verificar
# los refresh tokens.
#
# Debe ser diferente de JWT_SECRET.
REFRESH_SECRET=YOUR_REFRESH_SECRET


# ============================================================
# COOKIES
# ============================================================

# Indica si las cookies deben configurarse para
# escenarios cross-site.
#
# false = no utilizar configuración cross-site.
# true  = habilitar configuración cross-site según
#         la configuración de cookies de la aplicación.
COOKIE_CROSS_SITE=false


# ============================================================
# SIMULACIÓN / DESARROLLO
# ============================================================

# Determina si la aplicación utilizará datos o procesos
# simulados en determinadas funcionalidades.
#
# true  = utilizar simulación.
# false = utilizar comportamiento real.
USAR_SIMULACION=true
```
